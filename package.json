{
  "name": "ruang-tenang-kampus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/prismaGenerate.js && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:dev": "npm run db:generate:sqlite && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:production": "npm run db:generate:postgres && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 1000",
    "test": "node scripts/prismaGenerate.js && vitest run --fileParallelism=false",
    "test:unit": "node scripts/prismaGenerate.js && vitest run src/__tests__/unit server/__tests__/unit --fileParallelism=false",
    "test:integration": "node scripts/prismaGenerate.js && vitest run src/__tests__/integration server/__tests__/integration --fileParallelism=false",
    "test:security": "node scripts/prismaGenerate.js && vitest run src/__tests__/security server/__tests__/security --fileParallelism=false",
    "test:e2e": "playwright test",
    "db:backup": "tsx server/scripts/backupTool.ts",
    "db:generate:sqlite": "npx prisma generate --schema prisma/schema.sqlite.prisma",
    "db:generate:postgres": "npx prisma generate --schema prisma/schema.postgres.prisma",
    "db:push:sqlite": "npx prisma db push --schema prisma/schema.sqlite.prisma",
    "db:migrate:postgres": "npx prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "db:deploy:postgres": "npx prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "db:encrypt": "tsx server/scripts/migrateEncryption.ts",
    "seed:demo": "tsx server/scripts/seedDemoData.ts",
    "admin:bootstrap": "tsx server/scripts/bootstrapAdmin.ts"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@prisma/client": "6",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "twilio": "^6.0.2",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "exceljs": "^4.4.0",
    "glob": "^13.0.6",
    "jsdom": "^30.0.1",
    "pdfkit": "^0.20.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prisma": "6",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^4.1.11"
  }
}
