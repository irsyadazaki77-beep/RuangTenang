# Production Docker Ignore file for RuangTenang & RuangKerja

# Dependencies & Build Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.next/
out/

# Git & GitHub
.git/
.gitignore
.github/

# Environment Variables & Secrets (NEVER bake into images)
.env*
!.env.example

# Local SQLite & Temporary Databases
prisma/*.db
prisma/*.db-journal
prisma/ruangtenang_sqlite.db*

# Testing & Coverage
coverage/
playwright-report/
test-results/
.nyc_output/
*.test.ts
*.test.tsx
e2e/

# Uploads & Temporary Files
uploads/*
!uploads/.gitkeep
tmp/
temp/
*.log

# IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Documentation
docs/
RELEASE_CHECKLIST.md
screenshot.png
