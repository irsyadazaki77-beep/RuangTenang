# --- RUANGTENANG ENVIRONMENT CONFIGURATION ---
# Note: In production (NODE_ENV=production), secrets MUST be at least 32 characters and NOT use default/demo values.

# Server Environment & Port
NODE_ENV=development
PORT=3000

# Server Database Connection String (SQLite default)
DATABASE_URL="file:./ruangtenang_sqlite.db"

# JWT Authentication Secret (Required min 32 chars in production)
JWT_SECRET=

# AES-256-GCM Field-Level Data Encryption Key (Required 32-byte hex key in production)
ENCRYPTION_KEY=

# Google Gemini API Key (Server-side proxy, hidden from browser)
GEMINI_API_KEY=

# --- AI USER TIER DAILY USAGE LIMITS ---
DAILY_AI_LIMIT_FREE=25
DAILY_AI_LIMIT_PRO=100

# --- SEED & DEMO CONFIGURATION ---
# Set to 'true' in development to populate initial demo accounts. MUST be 'false' or unset in production.
SEED_DEMO_DATA=false

# Optional Twilio Gateway Config (Emergency SMS fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
