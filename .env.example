# REQUIRED in production (use independently generated values)
BLIND_INDEX_SECRET_FILE=./secrets/blind_index_secret
ENCRYPTION_KEY_FILE=./secrets/encryption_key
IP_HASH_KEY_FILE=./secrets/ip_hash_key
JWT_SECRET_FILE=./secrets/jwt_secret
BACKUP_ENCRYPTION_KEY_FILE=./secrets/backup_encryption_key
DATABASE_URL_FILE=./secrets/database_url
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
REDIS_PASSWORD_FILE=./secrets/redis_password
POSTGRES_USER=ruangtenang_admin
POSTGRES_DB=ruangtenang_prod
APP_ORIGIN=https://ruangtenang.example.ac.id
CORS_ALLOWED_ORIGINS=https://ruangtenang.example.ac.id
CANONICAL_HOST=ruangtenang.example.ac.id
PORT=3000
TRUST_PROXY=1

# OPTIONAL server-side providers (AI features use local fallback when unset)
DAILY_AI_LIMIT_FREE=
DAILY_AI_LIMIT_PRO=
# Set LOCAL_AI_ONLY=true to block cloud AI model providers. Tavily research search is separately opt-in in the Workspace plan panel; Crossref lookup remains external when requested.
# Ollama runs wherever OLLAMA_BASE_URL points; localhost means the app host, not necessarily the user's device.
LOCAL_AI_ONLY=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Bounded local context (2048–32768). Higher values consume more RAM/VRAM.
OLLAMA_NUM_CTX=8192
DEEPSEEK_API_KEY_FILE=./secrets/deepseek_api_key
GROQ_API_KEY_FILE=./secrets/groq_api_key
OPENROUTER_API_KEY_FILE=./secrets/openrouter_api_key
OPENAI_API_KEY_FILE=./secrets/openai_api_key
ENABLE_AI_DIAGNOSTICS=
GEMINI_API_KEY_FILE=./secrets/gemini_api_key
REDIS_URL=
SEED_DEMO_DATA=
TWILIO_ACCOUNT_SID_FILE=./secrets/twilio_account_sid
TWILIO_AUTH_TOKEN_FILE=./secrets/twilio_auth_token
TWILIO_PHONE_NUMBER=

# OPTIONAL TURN REST API settings. TURN_SHARED_SECRET is never sent to clients;
# the ICE endpoint derives credentials that expire after one hour.
TURN_URL=
TURN_USERNAME=
TURN_SHARED_SECRET_FILE=./secrets/turn_shared_secret
REQUIRE_TURN=false

# OPTIONAL, explicitly public client flag (never put credentials in VITE_PUBLIC_*).
VITE_PUBLIC_DEMO_MODE=false
SERVER_DEMO_MODE=false
# Server-side demo fixtures in counselor directory/analytics routes; defaults to real database data.

# Optional: enables the Agent 'search_web' research tool (https://tavily.com). Leave empty to disable.
TAVILY_API_KEY_FILE=./secrets/tavily_api_key

# Hugging Face Token (Optional, for Free FLUX.1 Image Generation)
HF_TOKEN=
