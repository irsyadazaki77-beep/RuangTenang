# REQUIRED in production (use independently generated values)
BLIND_INDEX_SECRET=
ENCRYPTION_KEY=
IP_HASH_KEY=
JWT_SECRET=
DATABASE_URL=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
POSTGRES_USER=ruangtenang_admin
POSTGRES_DB=ruangtenang_prod
APP_ORIGIN=https://ruangtenang.example.ac.id
CORS_ALLOWED_ORIGINS=https://ruangtenang.example.ac.id
PORT=3000
TRUST_PROXY=1

# OPTIONAL server-side providers (AI features use local fallback when unset)
DAILY_AI_LIMIT_FREE=
DAILY_AI_LIMIT_PRO=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ENABLE_AI_DIAGNOSTICS=
GEMINI_API_KEY=
REDIS_URL=
SEED_DEMO_DATA=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OPTIONAL TURN REST API settings. TURN_SHARED_SECRET is never sent to clients;
# the ICE endpoint derives credentials that expire after one hour.
TURN_URL=
TURN_USERNAME=
TURN_SHARED_SECRET=
REQUIRE_TURN=false

# OPTIONAL, explicitly public client flag (never put credentials in VITE_PUBLIC_*).
VITE_PUBLIC_DEMO_MODE=false
SERVER_DEMO_MODE=false
# Server-side demo fixtures in counselor directory/analytics routes; defaults to real database data.
